# Observability settings
# Set to true to enable detailed console logs in local development
VITE_ENABLE_LOGS=false

# Feature flags
# Profanity filter for spawned words, analogy answers, and player words.
# Production builds always filter, regardless of this flag.
# Local dev (yarn start) shows the unfiltered embedding space by default;
# set to "on" (e.g. in .env.local) to preview what players will see.
VITE_PROFANITY_FILTER=off
