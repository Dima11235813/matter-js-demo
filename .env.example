# Web app (Vite) configuration. Copy to .env.local (gitignored) and fill in.
# Every VITE_ value ships inside the web page: put only public configuration here, never a secret.
# Setup steps: docs/setup/accounts-and-deploy.md

# Observability settings
# Set to true to enable detailed console logs in local development
VITE_ENABLE_LOGS=false

# Feature flags
# Profanity filter for spawned words, analogy answers, and player words.
# Production builds always filter, regardless of this flag.
# Local dev (yarn start) shows the unfiltered embedding space by default;
# set to "on" (e.g. in .env.local) to preview what players will see.
VITE_PROFANITY_FILTER=off

# Firebase web config (Firebase console → Project settings → Your apps → Web). Leave empty to run
# without sign-in: accounts are optional.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Sentry error reports. Leave empty so this build never reports.
VITE_SENTRY_DSN=
