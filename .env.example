# Observability settings
# Set to true to enable detailed console logs in local development
VITE_ENABLE_LOGS=false

# Feature flags
# Profanity filter for spawned words, analogy answers, and player words.
# Only honored in local dev (yarn start); production builds always filter.
# Set to "off" (e.g. in .env.local) to inspect the unfiltered embedding space.
VITE_PROFANITY_FILTER=on
