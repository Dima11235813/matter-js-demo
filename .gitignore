# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (every workspace: root, server, packages/*)
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# custom overrides
/scratch
/test-results
/playwright-report
.env

# secrets never live in the repo (workspace standard SEC-03); .env.example is the only env file tracked
.env.*
!.env.example
secrets/
credentials*.json
*.pem
*.key
.mcp.json

# CI / deploy outputs
/dist-e2e
__pycache__/
/.wrangler

# The embedding vocabulary (public/vocab) is committed: hosts build in < 300 s, and embedding takes ~5 min.
# Rebuild with `yarn vocab:build` when its inputs change, and commit the result.
/.playwright-mcp

# stray Vite dependency cache (created when the dev server ran without package.json)
/.vite
