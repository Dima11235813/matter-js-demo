# Lexical Fountain API configuration. Copy to server/.env.local (gitignored) and fill in.
# Setup steps: docs/setup/accounts-and-deploy.md

# Port for the API (the web dev server proxies /api to it): this project's block is 41940–41959
# (D:\GDrive\proj-mgmt\inventory\local-ports.md); 41941 is the API. HOST defaults to 127.0.0.1 locally.
PORT=41941
HOST=

# Firebase project ID: sign-in tokens are only accepted for this project.
FIREBASE_PROJECT_ID=

# Production Postgres (Cloud SQL / Neon). Leave empty locally: the server then runs an in-process
# Postgres (PGlite) whose data lives in PGLITE_DATA_DIR, outside the Drive-synced tree.
DATABASE_URL=
PGLITE_DATA_DIR=

# Local dev and e2e: test sign-in without Google (POST /api/v1/dev/token). On by default whenever the
# server runs locally (no DATABASE_URL, not production) with a random secret per start; set a fixed
# DEV_AUTH_SECRET (16+ chars) to keep tokens valid across restarts, or DEV_AUTH=off to disable it.
# The server refuses to start with DEV_AUTH_SECRET when NODE_ENV=production.
DEV_AUTH_SECRET=
DEV_AUTH=
