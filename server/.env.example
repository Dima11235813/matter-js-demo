# Lexical Fountain API configuration. Copy to server/.env.local (gitignored) and fill in.
# Setup steps: docs/setup/accounts-and-deploy.md

# Port for the API (the web dev server proxies /api to it).
PORT=8787

# Firebase project ID: sign-in tokens are only accepted for this project.
FIREBASE_PROJECT_ID=

# Production Postgres (Cloud SQL / Neon). Leave empty locally: the server then runs an in-process
# Postgres (PGlite) whose data lives in PGLITE_DATA_DIR, outside the Drive-synced tree.
DATABASE_URL=
PGLITE_DATA_DIR=

# Local dev and e2e only: lets the server mint test sign-in tokens (POST /api/v1/dev/token). Any long
# random string. The server refuses to start with this set when NODE_ENV=production.
DEV_AUTH_SECRET=
